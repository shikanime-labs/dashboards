    {
      "type": "stat",
      "description": "Requests the llama.cpp server is processing right now.",
      "id": 12,
      "pluginVersion": "12.4.2",
      "title": "Active Requests",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 6 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum(llamacpp:requests_processing)",
          "legendFormat": "Active requests",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Requests waiting in the queue because every slot is busy. A growing value means demand exceeds capacity — add a replica or reduce context length.",
      "id": 101,
      "pluginVersion": "12.4.2",
      "title": "Deferred Requests",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 6 },
