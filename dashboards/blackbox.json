    },
    {
      "type": "table",
      "description": "One row per target: reachability, status code, probe duration and certificate headroom, joined on the target URL.",
      "id": 60,
      "title": "Target detail",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 63 },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "probe_success{job=\"blackbox\", instance=~\"$target\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "probe_http_status_code{job=\"blackbox\", instance=~\"$target\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "probe_duration_seconds{job=\"blackbox\", instance=~\"$target\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox\", instance=~\"$target\"} - time()) / 86400",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "Value #B": false,
              "job": true,
              "prometheus": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "HTTP",
              "Value #C": "Duration (s)",
              "Value #D": "Cert (d)",
              "instance": "Target"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              { "id": "unit", "value": "none" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "color": "red", "index": 0, "text": "DOWN" },
                      "1": { "color": "green", "index": 1, "text": "UP" }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HTTP" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Cert (d)" },
            "properties": [
              { "id": "unit", "value": "d" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      }
    }
