{
  "version": 1,
  "preload": false,
  "timepicker": {},
  "editable": true,
  "refresh": "1m",
  "graphTooltip": 1,
  "weekStart": "",
  "liveNow": false,
  "uid": "blackbox",
  "description": "Synthetic endpoint monitoring focused on service-level availability, error-budget burn, per-target reliability, TLS expiry and latency. HTTP status-code detail and diagnostic-only probe phases are intentionally omitted.",
  "schemaVersion": 42,
  "fiscalYearStartMonth": 0,
  "title": "Blackbox",
  "timezone": "utc",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["blackbox", "prometheus", "uptime", "slo", "shikanime"],
  "links": [
    {
      "url": "https://github.com/shikanime-labs/dashboards/blob/main/dashboards/blackbox.json",
      "allowInsecure": false,
      "isNewTab": true,
      "title": "Dashboard source",
      "tooltip": "View the dashboard JSON source on GitHub",
      "type": "link"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        }
      },
      {
        "name": "target",
        "type": "query",
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "label": "Target",
        "multi": true,
        "options": [],
        "refresh": 1,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": {
          "qryType": 1,
          "query": "label_values(probe_success{job=\"blackbox\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 50,
      "panels": [],
      "title": "Service level",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "gauge",
      "description": "Remaining share of the 1% error budget for the least reliable active endpoint. Red means the worst target has exhausted its budget — find it in the reliability table below.",
      "id": 10,
      "pluginVersion": "12.4.2",
      "title": "Error budget remaining (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "clamp_min(1 - ((1 - min((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d]))) and on(instance) min by (instance) (probe_success{job=\"blackbox\"}))) / 0.010000000000000009), 0) * 100",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Average uptime across active targets over 30 days. Below 99 means the fleet as a whole misses the objective.",
      "id": 11,
      "pluginVersion": "12.4.2",
      "title": "Availability (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "avg((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d]))) and on(instance) min by (instance) (probe_success{job=\"blackbox\"})) * 100",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Active targets below the 99% 30-day objective. Anything above zero is the work list for the week.",
      "id": 12,
      "pluginVersion": "12.4.2",
      "title": "SLO misses (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\"})) or vector(0)",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2.5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Endpoints currently failing their probe. This is the incident check: red here means something needs a human now.",
      "id": 43,
      "pluginVersion": "12.4.2",
      "title": "Targets down now",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "count(probe_success{job=\"blackbox\"} == 0) or vector(0)",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Error-budget burn for the worst endpoint. A burn rate of 1 spends the 30-day budget exactly; the multiwindow alert fires on fast-and-slow pairs above 14.4 and 6. Sustained values above 1 deserve investigation before they page.",
      "id": 14,
      "pluginVersion": "12.4.2",
      "title": "Burn rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[1h]))) / 0.010000000000000009",
          "instant": false,
          "legendFormat": "fast (1h)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[6h]))) / 0.010000000000000009",
          "instant": false,
          "legendFormat": "slow (6h)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "fontSize": 0,
            "grid": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Five-minute and one-hour rolling availability for the selected target set. A target linked to an outage shows a dip here before the 30-day average moves.",
      "id": 15,
      "pluginVersion": "12.4.2",
      "title": "Availability vs objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "avg(avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[5m])))",
          "instant": false,
          "legendFormat": "selected targets (5m)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "avg(avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[1h])))",
          "instant": false,
          "legendFormat": "selected targets (1h)",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 51,
      "panels": [],
      "title": "Targets",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "type": "barchart",
      "description": "Days until TLS expiry for the ten soonest-to-expire certificates among selected targets. Red under 21 days means schedule the renewal; the fleet cert rotates roughly every 90 days, so a sudden cluster at the same low value is the shared ingress certificate renewing — expected, not an incident.",
      "id": 44,
      "pluginVersion": "12.4.2",
      "title": "TLS certificates expiring soonest",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 22 },
      "options": {
        "barRadius": 0,
        "barWidth": 0.8,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "sizing": "auto",
        "stack": "none",
        "text": { "titleSize": 12, "valueSize": 12 },
        "tooltip": { "hideZeros": false, "mode": "single", "sort": "none" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "label_replace(bottomk(10, (probe_ssl_earliest_cert_expiry{job=\"blackbox\", instance=~\"$target\"} - time()) / 86400 and on(instance) probe_success{job=\"blackbox\", instance=~\"$target\"}), \"target\", \"$1\", \"instance\", \"https?://(([[][^]]+[]])|([0-9]{1,3}([.][0-9]{1,3}){3})|([^/:.]+)).*\")",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "description": "Active targets whose 30-day availability is below the 99% objective, with current probe state and estimated unavailable hours over the window. Empty means the whole selection meets the objective. Read it as the backlog of unreliable endpoints.",
      "id": 32,
      "pluginVersion": "12.4.2",
      "title": "Reliability — targets below 99% (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 22 },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "30d availability" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "label_replace((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}), \"target\", \"$1\", \"instance\", \"https?://(([[][^]]+[]])|([0-9]{1,3}([.][0-9]{1,3}){3})|([^/:.]+)).*\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{target}}",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}) and on(instance) ((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "current state",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "(1 - avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d]))) * 720 and on(instance) ((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "estimated unavailable hours",
          "range": false,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "current" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              { "id": "unit", "value": "short" },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "color": "red", "index": 1, "text": "DOWN" },
                      "1": { "color": "green", "index": 0, "text": "UP" }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 52,
      "panels": [],
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "type": "stat",
      "description": "Fleet p95 probe duration over 10 minutes. The SLOLatencyHigh alert fires above 1 second; below 100ms is healthy for public endpoints.",
      "id": 13,
      "pluginVersion": "12.4.2",
      "title": "p95 duration (10m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 33 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "quantile(0.95, avg_over_time(probe_duration_seconds{job=\"blackbox\"}[10m]))",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Fleet-wide p50, p95 and p99 probe duration. A rising p99 with flat p50 means one endpoint is slow — check the reliability table; both rising means network-wide degradation.",
      "id": 41,
      "pluginVersion": "12.4.2",
      "title": "Fleet probe duration spread",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 33 },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "quantile(0.5, probe_duration_seconds{job=\"blackbox\"})",
          "instant": false,
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "quantile(0.95, probe_duration_seconds{job=\"blackbox\"})",
          "instant": false,
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "quantile(0.99, probe_duration_seconds{job=\"blackbox\"})",
          "instant": false,
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "fontSize": 0,
            "grid": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "dashed" }
          },
          "mappings": [],
