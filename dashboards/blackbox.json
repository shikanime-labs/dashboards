{
  "version": 1,
  "preload": false,
  "timepicker": {},
  "editable": true,
  "refresh": "1m",
  "graphTooltip": 1,
  "weekStart": "",
  "liveNow": false,
  "uid": "blackbox",
  "description": "Synthetic endpoint monitoring focused on service-level availability, error-budget burn, per-target reliability, and latency. HTTP status-code detail and diagnostic-only probe phases are intentionally omitted.",
  "schemaVersion": 42,
  "fiscalYearStartMonth": 0,
  "title": "Blackbox",
  "timezone": "utc",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["blackbox", "prometheus", "uptime", "slo", "shikanime"],
  "links": [
    {
      "url": "https://github.com/shikanime-labs/dashboards/blob/main/dashboards/blackbox.json",
      "allowInsecure": false,
      "isNewTab": true,
      "title": "Dashboard source",
      "tooltip": "View the dashboard JSON source on GitHub",
      "type": "link"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        }
      },
      {
        "name": "target",
        "type": "query",
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "label": "Target",
        "multi": true,
        "options": [],
        "query": "label_values(probe_success{job=\"blackbox\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" }
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "description": "How much of the 30-day error budget is left. The SLO allows 1% downtime per month (99% objective, enforced by the SLOAvailabilityPage and SLOBurnRateFast alerts); the gauge shows the unspent share of that allowance. Red means the budget is gone and further failures breach the SLO.",
      "id": 10,
      "title": "Error budget remaining (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "clamp_min(1 - ((1 - avg(avg_over_time(probe_success{job=\"blackbox\"}[30d]))) / 0.010000000000000009), 0) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Average uptime across all monitored targets over the last 30 days, measured from probe_success. Green at or above the 99% objective, yellow down to 95%, red below.",
      "id": 11,
      "title": "Availability (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[30d]) and on(instance) probe_success{job=\"blackbox\"}) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Uptime of the least reliable target over 30 days. This is the number to watch when fleet averages look healthy; the Targets table at the bottom names the offender.",
      "id": 12,
      "title": "Worst target (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(avg_over_time(probe_success{job=\"blackbox\"}[30d]) and on(instance) probe_success{job=\"blackbox\"}) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Highest endpoint probe duration over 10 minutes. The SLOLatencyHigh alert fires above 1 second for 10 minutes on any endpoint; this max view exposes slow targets hidden by a fleet average.",
      "id": 13,
      "title": "Latency objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(avg_over_time(probe_duration_seconds{job=\"blackbox\"}[10m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Highest per-endpoint error-budget burn against the 99% availability objective. Rates above 1 spend budget faster than allowed; alert thresholds are 14.4 (fast) and 6 (slow).",
      "id": 14,
      "title": "Burn rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[1h]))) / 0.010000000000000009",
          "legendFormat": "fast (1h)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[6h]))) / 0.010000000000000009",
          "legendFormat": "slow (6h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fast (1h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 14.4 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "slow (6h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 6 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "description": "Fleet probe success over short (5m) and sustained (1h) windows. The dashed line is the 99% objective; short dips show active incidents, while the 1h line shows sustained impact.",
      "id": 15,
      "title": "Availability vs objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[5m]))",
          "legendFormat": "fleet (5m)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[1h]))",
          "legendFormat": "fleet (1h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "max": 1.001,
          "min": 0.94,
          "thresholds": {
            "fillColor": "rgba(255, 0, 0, 0.1)",
            "fillOpacity": 10,
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.99 }
            ],
            "style": "dashed"
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "description": "Thirty-day availability per endpoint, lowest first. Investigate any target below the 99% objective; use the target selector to focus the table.",
      "id": 32,
      "title": "Per-target availability (30d, worst first)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Availability" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d]) * 100 and on(instance) probe_success{job=\"blackbox\", instance=~\"$target\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "unit": "percent"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "job": true,
              "prometheus": true
            },
            "renameByName": { "Value": "Availability", "instance": "Target" }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "description": "Fleet-wide p50, p95, and p99 probe duration. Use p95/p99 to assess user-visible tail latency; sustained increases indicate degraded service even when probes succeed.",
      "id": 41,
      "title": "Fleet probe duration spread",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.5, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.95, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.99, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
