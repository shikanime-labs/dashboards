{
  "version": 1,
  "preload": false,
  "timepicker": {},
  "editable": true,
  "refresh": "1m",
  "graphTooltip": 1,
  "weekStart": "",
  "liveNow": false,
  "uid": "blackbox",
  "description": "Synthetic endpoint monitoring focused on service-level availability, error-budget burn, per-target reliability, and latency. HTTP status-code detail and diagnostic-only probe phases are intentionally omitted.",
  "schemaVersion": 42,
  "fiscalYearStartMonth": 0,
  "title": "Blackbox",
  "timezone": "utc",
  "time": { "from": "now-30d", "to": "now" },
  "tags": ["blackbox", "prometheus", "uptime", "slo", "shikanime"],
  "links": [
    {
      "url": "https://github.com/shikanime-labs/dashboards/blob/main/dashboards/blackbox.json",
      "allowInsecure": false,
      "isNewTab": true,
      "title": "Dashboard source",
      "tooltip": "View the dashboard JSON source on GitHub",
      "type": "link"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        }
      },
      {
        "name": "target",
        "type": "query",
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "label": "Target",
        "multi": true,
        "options": [],
        "query": "label_values(probe_success{job=\"blackbox\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" }
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "description": "Remaining share of the 1% availability error budget for the least reliable active endpoint, using available samples in the 30-day lookback. New or recreated probe series may have less than 30 days of data, so this value may reflect a shorter period. Red means the observed availability has exhausted its allowance; the per-target table names the endpoint.",
      "id": 10,
      "title": "Error budget remaining (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "clamp_min(1 - ((1 - min((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d]))) and on(instance) min by (instance) (probe_success{job=\"blackbox\"}))) / 0.010000000000000009), 0) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Average uptime across active targets using available samples in the 30-day lookback. New or recreated probe series may have less than 30 days of data, so this value may reflect a shorter period. Green at or above the 99% objective, yellow down to 95%, red below.",
      "id": 11,
      "title": "Availability (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d]))) and on(instance) min by (instance) (probe_success{job=\"blackbox\"})) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Count of active targets whose available samples in the 30-day lookback average below the 99% availability objective. New or recreated probe series may have less than 30 days of data, so the count reflects only available history; the table lists each miss. Zero means no active target is below objective in its available data.",
      "id": 12,
      "title": "SLO misses (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\"})) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Highest endpoint probe duration over 10 minutes. The SLOLatencyHigh alert fires above 1 second for 10 minutes on any endpoint; this max view exposes slow targets hidden by a fleet average.",
      "id": 13,
      "title": "Latency objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(avg_over_time(probe_duration_seconds{job=\"blackbox\"}[10m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Highest per-endpoint error-budget burn against the 99% availability objective. Rates above 1 spend budget faster than allowed; alert thresholds are 14.4 (fast) and 6 (slow).",
      "id": 14,
      "title": "Burn rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[1h]))) / 0.010000000000000009",
          "legendFormat": "fast (1h)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - min(avg_over_time(probe_success{job=\"blackbox\"}[6h]))) / 0.010000000000000009",
          "legendFormat": "slow (6h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fast (1h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 14.4 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "slow (6h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 6 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "description": "Five-minute and one-hour rolling availability for the selected target set. A target link selects one endpoint and a 30-day dashboard range; the chart shows only periods with stored probe samples. Use the 99% line to identify observed failure windows. New or recreated targets may have less than 30 days of history.",
      "id": 15,
      "title": "Availability vs objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[5m])))",
          "legendFormat": "selected targets (5m)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[1h])))",
          "legendFormat": "selected targets (1h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "max": 1.001,
          "min": 0.94,
          "thresholds": {
            "fillColor": "rgba(255, 0, 0, 0.1)",
            "fillOpacity": 10,
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.99 }
            ],
            "style": "dashed"
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "description": "Only active targets whose available probe samples in the 30-day lookback average below the 99% objective. Target is a short service/host label; the Links actions use the full instance URL. New or recreated targets may have less than 30 days of history; availability and projected unavailable hours then reflect only available samples, with downtime extrapolated to 720 hours. DOWN means investigate now; UP means review the linked target-filtered history. Zero misses and no rows mean no active target is below objective in available data.",
      "id": 32,
      "title": "Targets below 99% (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "30d availability" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "label_replace((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}), \"target\", \"$1\", \"instance\", \"https?://(([[][^]]+[]])|([0-9]{1,3}([.][0-9]{1,3}){3})|([^/:.]+)).*\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{target}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}) and on(instance) (avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99)",
          "format": "table",
          "instant": true,
          "legendFormat": "current state",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d]))) * 720 and on(instance) ((avg by (instance) (avg_over_time(probe_success{job=\"blackbox\", instance=~\"$target\"}[30d])) * 100 \u003c 99) and on(instance) min by (instance) (probe_success{job=\"blackbox\", instance=~\"$target\"}))",
          "format": "table",
          "instant": true,
          "legendFormat": "estimated unavailable hours",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outerTabular" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "Time #A": true,
              "Time #B": true,
              "Time #C": true,
              "job": true,
              "prometheus": true
            },
            "indexByName": {
              "Value #A": 2,
              "Value #B": 1,
              "Value #C": 3,
              "instance": 4,
              "target": 0
            },
            "renameByName": {
              "Value #A": "30d availability",
              "Value #B": "Current",
              "Value #C": "Estimated unavailable (h)",
              "instance": "Links",
              "target": "Target"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Target" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "Current" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": { "color": "red", "index": 0, "text": "DOWN" },
                      "1": { "color": "green", "index": 1, "text": "UP" }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background-solid" }
              },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "30d availability" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 99 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              { "id": "custom.width", "value": 260 }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Estimated unavailable (h)"
            },
            "properties": [
              { "id": "unit", "value": "h" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.width", "value": 190 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Links" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "data-links" } },
              {
                "id": "links",
                "value": [
                  {
                    "url": "/d/blackbox/blackbox?var-target=${__value.raw:percentencode}\u0026from=now-30d\u0026to=now",
                    "targetBlank": false,
                    "title": "View trend"
                  },
                  {
                    "url": "${__value.raw}",
                    "targetBlank": true,
                    "title": "Open endpoint"
                  }
                ]
              },
              { "id": "custom.width", "value": 200 }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "description": "Fleet-wide p50, p95, and p99 probe duration. Use p95/p99 to assess user-visible tail latency; sustained increases indicate degraded service even when probes succeed.",
      "id": 41,
      "title": "Fleet probe duration spread",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.5, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.95, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.99, probe_duration_seconds{job=\"blackbox\"})",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
