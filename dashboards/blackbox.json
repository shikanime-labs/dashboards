{
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 42,
  "timezone": "utc",
  "title": "Blackbox",
  "uid": "blackbox",
  "tags": ["blackbox", "prometheus", "uptime", "slo", "shikanime"],
  "time": { "from": "now-24h", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "Annotations \u0026 Alerts",
        "type": "dashboard",
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        }
      },
      {
        "name": "target",
        "type": "query",
        "allValue": ".*",
        "hide": 0,
        "includeAll": true,
        "label": "Target",
        "multi": true,
        "options": [],
        "query": "label_values(probe_success{job=\"blackbox\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 100,
      "panels": [],
      "title": "SLO",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "gauge",
      "description": "How much of the 30-day error budget is left. The SLO allows 1% downtime per month (99% objective, enforced by the SLOAvailabilityPage and SLOBurnRateFast alerts); the gauge shows the unspent share of that allowance. Red means the budget is gone and further failures breach the SLO.",
      "id": 10,
      "title": "Error budget remaining (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "clamp_min(1 - ((1 - avg(avg_over_time(probe_success{job=\"blackbox\"}[30d]))) / 0.010000000000000009), 0) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 50 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Average uptime across all monitored targets over the last 30 days, measured from probe_success. Green at or above the 99% objective, yellow down to 95%, red below.",
      "id": 11,
      "title": "Availability (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[30d]) and on(instance) probe_success{job=\"blackbox\"}) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Uptime of the least reliable target over 30 days. This is the number to watch when fleet averages look healthy; the Targets table at the bottom names the offender.",
      "id": 12,
      "title": "Worst target (30d)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(avg_over_time(probe_success{job=\"blackbox\"}[30d]) and on(instance) probe_success{job=\"blackbox\"}) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Average probe duration right now, smoothed over 10 minutes. The SLOLatencyHigh alert pages when this exceeds 1 second; yellow starts at 0.5.",
      "id": 13,
      "title": "Latency objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_duration_seconds{job=\"blackbox\"}[10m]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "How fast the error budget is being spent, where 1.0 is exactly sustainable. The fast (1h) line pages at 14.4, the slow (6h) line at 6 — both drawn dashed. Above a threshold means a sustained outage is burning budget fast enough to breach the SLO within days.",
      "id": 14,
      "title": "Burn rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - avg(avg_over_time(probe_success{job=\"blackbox\"}[1h]))) / 0.010000000000000009",
          "legendFormat": "fast (1h)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "(1 - avg(avg_over_time(probe_success{job=\"blackbox\"}[6h]))) / 0.010000000000000009",
          "legendFormat": "slow (6h)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fast (1h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 14.4 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "slow (6h)" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "fillColor": "rgba(255, 0, 0, 0)",
                  "fillOpacity": 0,
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 6 }
                  ],
                  "style": "dashed"
                }
              },
              {
                "id": "custom.thresholdsStyle",
                "value": { "lineWidth": 1, "mode": "dashed" }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "description": "Fleet uptime over 5-minute and 1-hour windows against the dashed 99% objective. The recorded series (blackbox:availability_ir) is the same input the alert rules evaluate, so dips here predict pages.",
      "id": 15,
      "title": "Availability vs objective",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[5m]))",
          "legendFormat": "fleet (5m)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avg_over_time(probe_success{job=\"blackbox\"}[1h]))",
          "legendFormat": "fleet (1h)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(blackbox:availability_ir)",
          "legendFormat": "recorded (1h)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 8,
            "gradientMode": "none",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "lineWidth": 1, "mode": "dashed" }
          },
          "max": 1.001,
          "min": 0.94,
          "thresholds": {
            "fillColor": "rgba(255, 0, 0, 0.1)",
            "fillOpacity": 10,
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.99 }
            ],
            "style": "dashed"
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 101,
      "panels": [],
      "title": "Summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "type": "stat",
      "description": "Targets whose last probe succeeded. Read together with Targets configured to spot silent gaps.",
      "id": 20,
      "title": "Probes up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 14 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(probe_success{job=\"blackbox\"} == 1) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 21,
      "title": "Probes down",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 14 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(probe_success{job=\"blackbox\"} == 0) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Total monitored targets, counted from live series rather than a hardcoded number, so a vanished probe config shows up here first.",
      "id": 22,
      "title": "Targets configured",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(probe_success{job=\"blackbox\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "description": "Fewest days remaining on any probed certificate. Under 14 days means renewal is due; under 30 start watching. The TLS section names the certificate.",
      "id": 23,
      "title": "Min certificate expiry",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 14 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min((probe_ssl_earliest_cert_expiry{job=\"blackbox\"} - time()) / 86400)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 14 },
              { "color": "green", "value": 30 }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 24,
      "title": "Median probe duration",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 14 },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "quantile(0.5, probe_duration_seconds{job=\"blackbox\"})",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "description": "Scraper replicas currently delivering probe samples. Zero here means monitoring itself is blind — targets may be fine but nothing would notice. One series per vmagent replica.",
      "id": 25,
      "title": "Scrape samples",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(up{job=\"blackbox\"} == 1) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 102,
      "panels": [],
      "title": "Availability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "state-timeline",
      "description": "One bar per target over time. Red bands are failing probes, gaps are missing data, and an all-green panel is the healthy state. The Probes down stat above carries the current count.",
      "id": 31,
      "title": "Probe state by target",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "options": {
        "alignValue": "left",
        "legend": { "calcs": [], "displayMode": "list", "placement": "right" },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValueControls": false,
        "showValueLabels": "auto",
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "probe_success{job=\"blackbox\", instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 100,
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false,
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "index": 0, "text": "down" },
                "1": { "color": "green", "index": 1, "text": "up" }
              }
            }
          ],
          "max": 1,
          "min": 0,
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "description": "Every target ranked by 30-day uptime, least reliable on the first row. This is where Worst target (30d) above gets its number.",
      "id": 32,
      "title": "Per-target availability (30d, worst first)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Availability" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg_over_time(probe_success{job=\"blackbox\"}[30d]) * 100 and on(instance) probe_success{job=\"blackbox\"}",
          "instant": true,
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
          "unit": "percent"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "Time": true,
              "job": true,
              "prometheus": true
            },
            "renameByName": { "Value": "Availability", "instance": "Target" }
          }
        }
      ]
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 106,
      "panels": [],
      "title": "HTTP responses",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "type": "piechart",
      "description": "How targets answered their last probe, grouped by response class. 5xx points at the backend, 4xx at routing or auth, and 'no response' at network, DNS or certificate failure.",
      "id": 70,
      "title": "HTTP status distribution",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "right",
          "showValue": true
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
