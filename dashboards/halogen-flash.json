          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "1000 * sum(rate(llamacpp:prompt_seconds_total[$__rate_interval])) / sum(clamp_min(rate(llamacpp:prompt_tokens_total[$__rate_interval]), 1e-9))",
