    {
      "type": "stat",
      "description": "Prompt processing speed in tokens per second across the fleet, shown only while requests are running.",
      "id": 102,
      "pluginVersion": "12.4.2",
      "title": "Prompt Throughput",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": [], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum(llamacpp:prompt_tokens_seconds) * on() group_left() (sum(llamacpp:requests_processing) \u003e bool 0)",
          "legendFormat": "Prompt throughput",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }]
          },
          "unit": "tokens/sec"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
