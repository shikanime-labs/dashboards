      "collapsed": false,
      "id": 15,
      "panels": [],
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "type": "timeseries",
      "description": "SQLAlchemy pool state of the API server. Checked-out near pool size with overflow growing means the DB is the bottleneck — slow queries hold connections.",
      "id": 16,
      "pluginVersion": "12.4.2",
      "title": "Connection pool",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "db_pool_connections{job=\"honcho\"}",
          "legendFormat": "{{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
