            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Seconds since the deriver last completed a metrics pass. Should stay near the run interval; climbing without bound means the deriver loop is stuck or crashing.",
      "id": 13,
      "pluginVersion": "12.4.2",
      "title": "Since last deriver success",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 23 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
