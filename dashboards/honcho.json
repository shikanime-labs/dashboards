            "fillOpacity": 10,
            "fontSize": 0,
            "grid": { "mode": "off" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "description": "Age of the oldest item still waiting in the deriver queue. Growing past a few minutes means work is being starved, not just batched.",
      "id": 12,
      "pluginVersion": "12.4.2",
      "title": "Oldest pending age",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 23 },
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "hideZeros": false, "mode": "multi", "sort": "desc" }
