      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "deriver_queue_oldest_pending_age_seconds{job=\"honcho\"}",
          "legendFormat": "oldest",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
