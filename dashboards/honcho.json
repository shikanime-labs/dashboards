      "description": "Events buffered by the telemetry exporter. Steady growth means the OTel sink is blocked or down while events keep accumulating in memory.",
      "id": 14,
      "pluginVersion": "12.4.2",
      "title": "Telemetry buffer",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 23 },
